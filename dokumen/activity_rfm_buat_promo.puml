skinparam SwimlaneTitleBackgroundColor #FFFFFF
skinparam SwimlaneTitleFontColor #000000

title Aktivitas: Memilih Customer dan Buat Promo

|Pengguna|
start
:Memilih customer
melalui checkbox atau kartu segment;
:Klik tombol "Buat Promo";

|Sistem|
if (Minimal 1 customer dipilih?) then (Ya)
  :Menyimpan customer terpilih
  ke session storage;
  :Membuka halaman Promo Campaign;
  |Pengguna|
  :Melanjutkan pembuatan promo
  di halaman Promo Campaign;
  stop
else (Tidak)
  :Menampilkan pesan error
  "Pilih minimal 1 customer";
  |Pengguna|
  :Memilih customer terlebih dahulu;
  stop
endif
@enduml
