title Aktivitas: Membuat Promo Campaign

|Pengguna|
start
if (Datang dari Analisis RFM?) then (Ya)
  |Sistem|
  :Membuka form campaign
  dengan penerima terpilih;
  |Pengguna|
  :Melanjutkan pengisian form;
else (Tidak)
  :Klik tombol "Buat Campaign";
  |Sistem|
  :Menampilkan form campaign;
  |Pengguna|
  :Mengisi judul, pesan,
  dan dokumen opsional;
  :Memilih penerima customer;
endif
:Klik tombol "Simpan Draft";

|Sistem|
if (Judul, pesan, dan
minimal 1 penerima valid?) then (Ya)
  :Menyimpan campaign
  sebagai draft;
  :Menampilkan pesan sukses;
  :Memuat ulang daftar campaign;
  |Pengguna|
  :Melihat campaign draft
  di daftar campaign;
  stop
else (Tidak)
  :Menampilkan pesan error
  validasi;
  |Pengguna|
  :Memperbaiki data pada form;
  stop
endif
